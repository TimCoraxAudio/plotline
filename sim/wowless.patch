+-- Plotline patch: save the fonts the text uses, so a renderer can draw it.
+if args.dump then
+  local seen = {}
+  for _, f in ipairs(data.frames) do
+    for _, r in ipairs(f.regions) do
+      local font = r.content.font
+      local fp = font and font.path and font.path:lower():gsub('\\', '/')
+      if fp and not seen[fp] then
+        seen[fp] = true
+        local content = fetch(fp)
+        if content then
+          local fh = io.open(args.dump .. '/' .. fp:gsub('[^%w]', '_') .. '.font', 'wb')
+          fh:write(content)
+          fh:close()
+        else
+          print('no font ' .. fp)
+        end
+      end
+    end
+  end
+end
